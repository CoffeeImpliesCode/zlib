.{
    .name = .zlib_consumer,
    .version = "0.1.0",
    // This consumer has a separate fingerprint because it has a different
    // package name from the library.
    .fingerprint = 0xe49e67b05f28e789,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // A relative path, not a registry or archive URL. The consumer is the
        // proof that `dep.module("zlib")` works from outside the package that
        // defines it; resolving that through the network would make the proof
        // depend on a published state of the world instead.
        .zlib = .{ .path = ".." },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
    },
}